# Copy this file to .env.local and fill in your values.

# MySQL connection: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Special characters in the password must be URL-encoded (@ -> %40, # -> %23)
DATABASE_URL=mysql://root:YOUR_PASSWORD@127.0.0.1:3306/care_booking

# Secret used to sign login cookies. At least 32 random characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-64-characters-xxxxxxxxxxxx
